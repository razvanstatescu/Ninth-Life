# Decoder Lambda environment (set by packages/infra; listed here for local runs).
# Never commit real values. Account IDs and secrets do not belong in this repo.
AWS_REGION=eu-central-1
MODEL_PROFILE=haiku-4.5
QUOTA_TABLE=ninthlife-quota-placeholder
FLAG_PARAM=/ninthlife/llm_enabled
SALT_PARAM=/ninthlife/ip_salt
ALLOWED_ORIGINS=http://localhost:3000
LLM_TIMEOUT_MS=1200
# Next.js route adapter only: "true" enables the LLM (kill switch as an env var).
LLM_ENABLED=false
