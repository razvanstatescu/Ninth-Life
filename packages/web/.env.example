# Ninth Life web app. Copy to .env.local for local dev; set the same names in the Vercel project
# settings (Production and Preview). Never commit real values.

# Model ranking (POST /api/decode). Off unless this is exactly "true". Redeploy after changing it.
LLM_ENABLED=false

# --- Provider: set the key for ONE provider (ADR-001 Anthropic, ADR-002 MiniMax) -----------------
# Anthropic API key from a dedicated Console workspace with a monthly spend limit (see docs/architecture/decoder.md).
ANTHROPIC_API_KEY=
# MiniMax API key (Anthropic-compatible endpoint). With only this key set, MiniMax-M3 is the default model.
MINIMAX_API_KEY=
# MiniMax base URL. Default: https://api.minimax.io/anthropic (international). Set it only if your
# key belongs to another MiniMax host (for example a regional one); ".../anthropic" or the full
# ".../anthropic/v1/messages" both work.
MINIMAX_BASE_URL=

# claude-haiku-5-5 (default) | claude-haiku-4-5 | MiniMax-M3 (default with only MINIMAX_API_KEY) | MiniMax-M3.1-Flash
# Leave empty to pick the default for whichever key is set.
DECODE_MODEL=

# Server-side model deadline in ms (default 1200, range 300-9000). MiniMax from the EU is usually
# slower than 1.2 s; 2000 is the measured choice for MiniMax-M3 (docs/research/minimax-models.md).
# The client waits this + 300 ms (override with NEXT_PUBLIC_DECODE_TIMEOUT_MS). Restart dev / rebuild after changing.
DECODE_TIMEOUT_MS=

# Random string of at least 16 characters, e.g. the output of: openssl rand -hex 32
IP_HASH_SALT=
# Extra allowed origins, comma-separated (the deployment's own origin is always allowed)
ALLOWED_ORIGINS=
# Dev only: "true" uses the decoder's fake model, no key needed (ignored in production)
DECODE_FAKE_LLM=false
# Optional: send decode requests somewhere other than /api/decode (normally unset)
NEXT_PUBLIC_DECODE_URL=
