# Production settings for https://night.statescu.net. Committed on purpose: nothing secret goes here.
# Secrets (MINIMAX_API_KEY, IP_HASH_SALT) live in .env.production.local (git-ignored) and in the
# Vercel project's Environment Variables. A value set in Vercel overrides this file, so setting
# LLM_ENABLED=false there is still the kill switch (docs/architecture/decoder.md, Runbook §4).

# The site's origin: canonical links, og:url, the social card, sitemap.xml and llms.txt.
SITE_URL=https://night.statescu.net

# Model ranking with MiniMax (ADR-002). DECODE_MODEL picks the provider, so the route uses
# MINIMAX_API_KEY and the website and Settings name MiniMax (NEXT_PUBLIC_DECODE_PROVIDER is derived
# from it at build). MiniMax-M3 is the model the eval measured with thinking off; MiniMax-M3.1-Flash
# always thinks and is likely too slow for the route. Without the key the route answers 503
# llm_disabled and the app stays offline-only.
LLM_ENABLED=true
DECODE_MODEL=MiniMax-M3

# The model's deadline in ms (300-9000, default 1200). Every late answer falls back to the offline
# ranking. 2000 because MiniMax-M3 answered in 0.7-1.1 s live on 2026-11-17 and the eval had 24.8% of
# calls over 1.2 s. The client's budget is derived from it at build (+300 ms).
DECODE_TIMEOUT_MS=2000

# Only for a regional MiniMax host; the default is https://api.minimax.io/anthropic.
# MINIMAX_BASE_URL=
